# Copy to .env (never commit it) or point ENGINE_ENV at a file outside the repo.
SITE_URL=https://www.example.com
BLOG_PATH=/blog
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public by design: it can only read published rows (see supabase/articles.sql).
SUPABASE_ANON_KEY=
# Bypasses row-level security. Needed only to write rows and upload images. Never print or commit it.
SUPABASE_SERVICE_ROLE_KEY=
ARTICLES_TABLE=articles
IMAGES_BUCKET=blog-images
# Regex for the script a fully deployed article page loads (Vite default: assets/index-<hash>.js).
BUNDLE_PATTERN=assets/[\w.-]+\.js
# Optional: a URL that starts a production build when POSTed. Leave empty to deploy by hand.
DEPLOY_HOOK_URL=
